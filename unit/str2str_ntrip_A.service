[Unit]
Description=RTKBase Ntrip A
#After=network-online.target
#Wants=network-online.target

[Service]
Type=simple
SyslogIdentifier=str2str_ntrip_A
User={user}
ExecStart={script_path}/run_cast.sh in_tcp out_caster_A
Restart=on-failure
RestartSec=30
#Limiting log to 1 msg per minute
LogRateLimitIntervalSec=1 minute
LogRateLimitBurst=1
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths={script_path}

[Install]
WantedBy=multi-user.target
